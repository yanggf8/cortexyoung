# Rust/editor output. Deliberately NO node_modules/ or *.tsbuildinfo: this repo is pure Rust, and
# an ignore rule would hide exactly the evidence we want `git status` to surface if a Node tree
# ever reappears.
dist/
build/

# Machine-local state, not source: the cort index, the embedding model cache, scratch logs and
# generated performance reports. None of these belong in git; each is rebuilt on demand.
.cortex/
.fastembed_cache/
logs/
performance-reports/

# Scratch directory the skill-format negative test builds and removes inside `cargo test`.
rust/tests/.gate-probe/

# Machine-local Claude Code settings and generated reports — never commit
.claude/settings.local.json
CORTEX_REPORT.md

# Codex drops a zero-byte marker in the working directory it was started from.
.codex

# OS / editor (minimal)
.DS_Store
*.swp
*.swo

# claudecat (root crate, merged 2026-09-23): its build output and runtime leftovers from the
# legacy tree. Cargo.lock stays tracked for binary reproducibility. legacy/ is the one place a
# Node tree is legitimate — it carries the repo's only tracked package.json — so its node_modules/
# is scoped-ignored; node_modules/ anywhere else stays unignored as evidence of a Node toolchain
# appearing where none belongs.
/target
legacy/node_modules/
*.claudecat.tmp
test-projects/
pids
*.pid
*.pid.lock
coverage/
.nyc_output
*.log
.env
.env.*
