#!/usr/bin/env python3
"""Scriptable stand-in for ast-grep, driven by FAKE_AG_MODE.

Equivalent of tests/fixtures/fake-ast-grep.js. Only used for pathological
paths; happy paths use the real binary.
"""
import base64
import os
import sys
import time

mode = os.environ.get("FAKE_AG_MODE", "")
args = sys.argv[1:]

if args[:1] == ["--version"]:
    v = mode[len("version:"):] if mode.startswith("version:") else "0.45.2"
    sys.stdout.write(f"ast-grep {v}\n")
    sys.stdout.flush()
    sys.exit(0)

if mode == "hang":
    time.sleep(60)
elif mode == "streams":
    sys.stdout.write("OUT\n")
    sys.stdout.flush()
    sys.stderr.write("ERR\n")
    sys.stderr.flush()
    sys.exit(1)
elif mode == "empty":
    sys.exit(1)
elif mode.startswith("emit:"):
    sys.stdout.write(base64.b64decode(mode[len("emit:"):]).decode("utf-8"))
    sys.stdout.flush()
    sys.exit(0)
elif mode.startswith("preflight-bad"):
    sys.stderr.write(
        "Debug AST:\nprogram (0,0)-(0,10)\n  ERROR (0,0)-(0,10)\n\n"
        "Warning: Pattern contains an ERROR node and may cause unexpected results.\n"
    )
    sys.stderr.flush()
    sys.exit(0)
elif mode == "preflight-ok":
    sys.stderr.write("Debug AST:\nprogram (0,0)-(0,9)\n")
    sys.stderr.flush()
    sys.exit(0)
else:
    sys.exit(0)
